# Copy to .env.local for local dev/ingest, and set the same keys in
# Vercel → Project Settings → Environment Variables for production.
# None of these are required to run the app — without them it automatically
# falls back to the built-in lexical keyword retriever.

# --- Supabase (vector store) ---
# From your Supabase project: Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings provider (OpenAI-compatible) ---
EMBEDDINGS_API_KEY=
# Optional overrides:
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
